# AgentMail server credentials
AGENTMAIL_API_KEY=your_agentmail_api_key
AGENTMAIL_INBOX_ID=your_inbox_id@agentmail.to
AGENTMAIL_WEBHOOK_SECRET=

# Public origin used when registering the AgentMail webhook
APP_BASE_URL=http://localhost:3000

# Browserbase cloud browser credentials
BROWSERBASE_API_KEY=your_browserbase_api_key
BROWSERBASE_PROJECT_ID=your_browserbase_project_id

# Google Gemini API credentials (powered by Google ADK)
GEMINI_API_KEY=your_gemini_api_key
# Optional: GEMINI_MODEL=gemini-3.7-flash

# Guarded synthetic email integration test; keep disabled except during a local test run
APOVO_EMAIL_TEST_MODE=0
APOVO_APPLICATION_TEST_MODE=0

# Protected Vercel MVP demo. Leave disabled for the local file-backed workflow.
APOVO_DEPLOYMENT_MODE=local
# Generate a unique 32+ character secret and add it as a Vercel Sensitive variable.
APOVO_DEMO_SESSION_SECRET=
